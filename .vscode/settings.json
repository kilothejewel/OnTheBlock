{
  "C_Cpp.files.exclude": {
    "**/.venv": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true
  },
  "python.analysis.exclude": [
    "**/.venv"
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/.venv/Lib/site-packages"
  ]
}
