{
  // Type-checks the API client against the generated types (npm run check:api).
  // Only these files: the rest of web/ is plain JavaScript.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "files": ["src/lib/api.js", "src/lib/api-types.ts", "src/lib/api-types.check.js"]
}
