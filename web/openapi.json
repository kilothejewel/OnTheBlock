    "/api/v1/cities": {
      "get": {
        "tags": [
          "cities"
        ],
        "summary": "List Cities",
        "description": "The cities that take new Plans, for the web and mobile pickers: South\nAfrican cities first (live, then beta), then international ones. Hidden\ncities are left out. Open to everyone.",
        "operationId": "list_cities_api_v1_cities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CityOut"
                  },
                  "type": "array",
                  "title": "Response List Cities Api V1 Cities Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hotspots/recommend": {
      "get": {
        "tags": [
          "hotspots"
        ],
        "summary": "Recommend Hotspots",
        "description": "Search places in one of the supported cities with Google Places.\n\nRate limited to 20 requests/minute per client (each call hits Google Places).",
        "operationId": "recommend_hotspots_api_v1_hotspots_recommend_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "title": "Query"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "cape-town",
                "johannesburg",
                "durban",
                "pretoria",
                "stellenbosch",
                "miami",
                "london",
                "tokyo"
              ],
              "default": "cape-town",
              "title": "City"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HotspotCreate"
                  },
                  "title": "Response Recommend Hotspots Api V1 Hotspots Recommend Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
