# Core Settings
OTB_PROJECT_NAME=OnTheBlock
OTB_VERSION=1.0.0
OTB_API_V1_STR=/api/v1

# Database Settings
OTB_POSTGRES_SERVER=localhost
OTB_POSTGRES_USER=postgres
OTB_POSTGRES_PASSWORD=your_postgres_password
OTB_POSTGRES_DB=ontheblock_db
# Optional: set a full SQLAlchemy URL to override the POSTGRES_* values above.
# Handy for local development / tests, e.g. SQLite:
# OTB_DATABASE_URL=sqlite:///./ontheblock.db

# OpenAI Settings
OTB_OPENAI_API_KEY=your_openai_api_key
# Chat model used for itinerary generation (default: gpt-4o-mini)
OTB_OPENAI_MODEL=gpt-4o-mini

# Google Places Settings
OTB_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Auth / JWT Settings
# Generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
OTB_SECRET_KEY=your_jwt_secret_key
OTB_ALGORITHM=HS256

# CORS: comma-separated list of browser origins allowed to call the API
OTB_FRONTEND_ORIGINS=http://localhost:5173
